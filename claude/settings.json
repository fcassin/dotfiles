{
  "theme": "dark",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/personal/sync",
            "statusMessage": "Syncing personal notes...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
